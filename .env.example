# Salesforce Sandbox Credentials
SF_INSTANCE_URL="https://your-sandbox.sandbox.my.salesforce.com"
SF_ACCESS_TOKEN="your_oauth_access_token_here"

# QuickBooks Sandbox Credentials
QB_REALM_ID="your_realm_id"
QB_ACCESS_TOKEN="your_oauth_access_token_here"

# Feature Flags
IGT_SHADOW_MODE="false"
